---
import { Icon } from "astro-icon/components";
import type { TechGroup } from "@/lib/docs";
import { docShortTitle } from "@/lib/docs";
import { docUrl, techUrl } from "@/lib/paths";

interface Props {
	group: TechGroup;
	/** Máximo de chips exibidos. */
	limit?: number;
}
const { group, limit = 4 } = Astro.props;
const { tech, meta, docs } = group;
const chips = docs
	.filter((doc) => doc.data.learning?.kind !== "orientation")
	.slice(0, limit);
---

<section
	class="tech-block"
	id={tech}
	style={`--tech-accent: ${meta.accent}`}
	data-reveal
>
	<div class="tech-header">
		<span
			class="tech-icon grid size-11 shrink-0 place-items-center rounded-2xl"
		>
			<Icon name={meta.icon} class="size-[1.4rem]" />
		</span>
		<div class="min-w-0">
			<h3 class="font-display text-xl font-semibold text-ink">{meta.label}</h3>
			<p class="mt-0.5 text-sm text-muted">{meta.tagline}</p>
		</div>
	</div>

	<ul class="tech-chips grid grid-cols-2 gap-2">
		{
			chips.map((doc) => (
				<li>
					<a href={docUrl(doc.data.tech, doc.id)} class="tech-chip">
						{docShortTitle(doc)}
					</a>
				</li>
			))
		}
	</ul>

	<a
		href={techUrl(tech)}
		class="tech-more group flex w-fit items-center gap-1.5 font-mono text-xs"
	>
		{
			tech === "sistemas"
				? "Explorar a formação"
				: `Ver ${docs.length} ${docs.length === 1 ? "guia" : "guias"}`
		}
		<Icon
			name="lucide:arrow-right"
			class="size-3.5 transition-transform duration-fast group-hover:translate-x-0.5"
		/>
	</a>
</section>

<style>
	.tech-block {
		display: flex;
		min-height: 100%;
		flex-direction: column;
		scroll-margin-top: var(--nav-h);
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface-1);
		padding: 1.5rem;
		transition: transform var(--dur-base) var(--ease-out);
	}
	.tech-block:hover,
	.tech-block:focus-within {
		transform: translateY(-2px) scale(1.01);
	}

	.tech-header {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.tech-icon {
		color: var(--tech-accent);
		background: color-mix(in oklab, var(--tech-accent) 14%, transparent);
	}

	.tech-more {
		margin-top: auto;
		padding-top: 1rem;
		color: var(--tech-accent);
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.tech-more:hover {
		opacity: 0.75;
	}

	.tech-chip {
		display: block;
		border-radius: var(--radius-sm);
		background: var(--color-surface-2);
		color: var(--color-ink-soft);
		padding: 0.55rem 0.8rem;
		font-size: 0.8rem;
		line-height: 1.25;
		transition:
			background var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.tech-chip:hover {
		color: var(--tech-accent);
		background: color-mix(in oklab, var(--tech-accent) 12%, transparent);
	}
</style>
