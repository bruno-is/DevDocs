---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Entry from "@/components/docs/Entry.astro";
import { getAllDocs, TECH_META, techAccentVars } from "@/lib/docs";
import { docUrl, withBase } from "@/lib/paths";
const docs = (await getAllDocs()).filter((doc) => doc.data.tech === "sistemas");
const overview = docs.find((doc) => doc.data.learning?.kind === "orientation")!;
const chapters = docs.filter(
	(doc) => doc.data.learning?.kind !== "orientation",
);
const meta = TECH_META.sistemas;
const [title, continuation] = meta.label.split(" & ");
const levels = {
	fundamentos: "Fundamentos",
	intermediario: "Intermediário",
	avancado: "Avançado",
};
---

<SiteLayout title={meta.label} description={overview.data.subtitle}>
	<main
		class="mx-auto max-w-7xl px-5 py-10 sm:py-16"
		style={techAccentVars(meta.accent)}
		data-search-tech="sistemas"
		data-search-tech-label="Sistemas"
	>
		<a
			href={withBase("/")}
			class="font-mono text-xs text-muted hover:text-accent">← DevDocs</a
		>
		<header class="mt-10 max-w-4xl" data-reveal>
			<p class="font-mono text-xs tracking-widest text-accent uppercase">
				Formação avançada · {chapters.length} módulos
			</p>
			<h1
				class="mt-5 font-display text-4xl leading-tight font-semibold text-ink sm:text-6xl"
			>
				{title}<br /><span class="text-accent-strong"
					>&amp; {continuation}</span>
			</h1>
			<p class="mt-6 max-w-reading text-lg leading-relaxed text-muted">
				{overview.data.subtitle}
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a
					class="rounded-xl bg-surface-3 px-5 py-3 text-sm text-accent-strong hover:bg-surface-2"
					href={docUrl("sistemas", chapters[0].id)}
					>Começar pelos fundamentos →</a
				>
				<a
					class="rounded-xl bg-surface-1 px-5 py-3 text-sm text-ink-soft hover:bg-surface-2"
					href={withBase("/labs/sistemas.zip")}
					download>Baixar laboratórios (ZIP)</a
				>
			</div>
		</header>
		<section class="mt-16" aria-labelledby="mapa">
			<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
				<h2 id="mapa" class="font-display text-2xl font-semibold text-ink">
					Seu percurso de estudo
				</h2>
				<p
					class="font-mono text-xs text-muted"
					data-learning-summary
					aria-live="polite"
				>
					0 de {chapters.length} capítulos marcados como estudados
				</p>
			</div>
			<ol class="grid gap-4 md:grid-cols-2">
				{
					chapters.map((doc, index) => (
						<li
							class="min-w-0 rounded-2xl bg-surface-1 p-5 sm:p-6"
							data-learning-id={doc.id}
							data-reveal
						>
							<div class="flex flex-wrap justify-between gap-3 font-mono text-xs text-accent">
								<span>
									{String(index + 1).padStart(2, "0")} ·{" "}
									{levels[doc.data.learning!.level]}
								</span>
								<span class="text-muted" data-learning-status>
									A estudar
								</span>
							</div>
							<h3 class="mt-4 font-display text-xl font-semibold text-ink">
								<a
									class="hover:text-accent-strong"
									href={docUrl("sistemas", doc.id)}
								>
									{doc.data.title}
								</a>
							</h3>
							<p class="wrap-anywhere mt-3 text-sm leading-relaxed text-muted">
								{doc.data.cardDescription ?? doc.data.subtitle}
							</p>
							<p class="mt-4 font-mono text-xs text-muted">
								{doc.data.sections.length} tópicos · {doc.data.learning!.module}
							</p>
							{doc.data.learning!.prerequisites.length > 0 && (
								<p class="mt-3 text-xs leading-relaxed text-muted">
									Antes:{" "}
									{doc.data
										.learning!.prerequisites.map(
											(id) =>
												docs.find((d) => d.id === id)!.data.learning!.module,
										)
										.join(" · ")}
								</p>
							)}
						</li>
					))
				}
			</ol>
			<p class="mt-4 text-xs text-muted" data-learning-note>
				Progresso salvo somente neste navegador. Não há conta ou certificado.
			</p>
		</section>
		<div class="mt-20 grid max-w-4xl gap-16">
			{
				overview.data.sections.map((section) => (
					<section aria-labelledby={section.id}>
						<h2
							id={section.id}
							class="mb-8 scroll-mt-doc-sticky font-display text-2xl font-semibold text-ink"
						>
							{section.name}
						</h2>
						<div class="grid gap-10">
							{section.entries.map((entry) => (
								<Entry entry={entry} />
							))}
						</div>
					</section>
				))
			}
		</div>
	</main>
	<script>
		import "@/scripts/learning-progress";
	</script>
</SiteLayout>
