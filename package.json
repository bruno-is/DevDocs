{
  "name": "devdocs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "DevDocs — biblioteca pessoal de documentacoes tecnicas (Astro + Vue).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm test && node scripts/package-labs.mjs",
    "build": "astro check && astro build && pagefind --site dist",
    "postbuild": "npm run check:links",
    "build:fast": "astro build && pagefind --site dist",
    "prebuild:fast": "npm test && node scripts/package-labs.mjs",
    "postbuild:fast": "npm run check:links",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-strip-types --test scripts/learning.test.mjs scripts/learning-progress.test.mjs",
    "check:links": "node scripts/check-built-links.mjs",
    "migrate": "node scripts/migrate-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/onest": "^5.2.11",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@iconify-json/lucide": "^1.2.68",
    "@iconify-json/simple-icons": "^1.2.60",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "astro-icon": "^1.1.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "motion-v": "^2.3.0",
    "reka-ui": "^2.10.1",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.0.0",
    "@php-wasm/web-8-4": "^3.1.43",
    "pagefind": "^1.5.2",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "yaml": "^2.6.1"
  }
}
